{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8123",
        "--directory",
        "design-preview"
      ],
      "port": 8123
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "prod-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3110"
      ],
      "port": 3110
    },
    {
      "name": "gate-prelaunch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "Object.assign(process.env,{PUBLIC_HOST:'equineprofessionals.com.au',SITE_LAUNCHED:'false',REDIRECT_HOSTS:'equineprofessionals.au',TEST_AUTH_USER:'kim',TEST_AUTH_PASSWORD:'hoofbeats'});require('child_process').spawn('npx next start -p 3120',{stdio:'inherit',shell:true})"
      ],
      "port": 3120
    }
