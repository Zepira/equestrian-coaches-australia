# Copy to .env.local and fill in — see CLAUDE.md for provider decisions.
# None of these are required yet; wired up in the Data+Auth / Payments
# build phases.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_STANDARD=
NEXT_PUBLIC_STRIPE_PRICE_CLINICS=

# Resend (email notifications)
RESEND_API_KEY=

# Site URL used in notification emails and Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the /api/cron/notify-clinics and /api/cron/seo-digest
# backstop jobs (Vercel Cron sends it automatically once configured; only
# needed for manual calls)
CRON_SECRET=

# Google Search Console (weekly SEO digest, /api/cron/seo-digest) — a
# service account's full JSON key as one line, plus the verified property
# URL (e.g. "sc-domain:equestriancoaches.com.au"). The service account also
# needs to be added as a user on the property in Search Console itself, or
# every request 403s. Digest still runs and emails without these — the
# GSC-dependent sections just note they're not connected yet.
GOOGLE_SERVICE_ACCOUNT_KEY=
GSC_SITE_URL=

# Recipient for the weekly SEO digest email
SEO_DIGEST_EMAIL=
