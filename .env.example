# Copy to .env.local and fill in — see CLAUDE.md for provider decisions.
# None of these are required yet; wired up in the Data+Auth / Payments
# build phases.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_STANDARD=
NEXT_PUBLIC_STRIPE_PRICE_CLINICS=

# Resend (email notifications)
RESEND_API_KEY=

# Site URL used in notification emails and Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the /api/cron/notify-clinics backstop job (Vercel Cron
# sends it automatically once configured; only needed for manual calls)
CRON_SECRET=
