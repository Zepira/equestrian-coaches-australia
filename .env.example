# Copy to .env and fill in. See CLAUDE.md for the provider decisions and
# docs/launch.md for which of these change on launch day.

# ── Which host serves what, and whether the site has launched ──────────────
# See src/lib/launch.ts. Everything here fails closed: unset means not
# launched, no public host, and no access to a gated host.

# The one host that serves the site publicly, no scheme and no trailing slash.
# Every other host the deployment answers on (test, previews, the project's
# own *.vercel.app address) is password protected and noindex because of this.
PUBLIC_HOST=equineprofessionals.com.au

# "true" and nothing else opens the site. While it is anything else, the
# public host serves only the coming soon page.
SITE_LAUNCHED=false

# Hosts that 301 to PUBLIC_HOST, comma separated. www.<PUBLIC_HOST> always
# redirects without being listed, so this is for extra domains, e.g. the .au.
REDIRECT_HOSTS=equineprofessionals.au,www.equineprofessionals.au

# The password for every gated host. Both must be set or those hosts serve a
# 503 rather than opening up.
TEST_AUTH_USER=
TEST_AUTH_PASSWORD=

# Whether the scheduled bulk emails actually send: the monthly rider
# round-up, the monthly provider numbers and the founding reminders. While
# this is off those jobs still run and still log what they would have sent,
# so the test site can exercise them without mailing anyone. Transactional
# email (enquiries, a profile going live, the waitlist confirmation) ignores it.
CRON_EMAILS_ENABLED=false

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The Postgres password, separate from the API keys above. Needed by
# scripts/db/run-migration.mjs and scripts/db/rebuild.mjs, not by the app.
DATABASE_PASSWORD=

# ── Stripe ────────────────────────────────────────────────────────────────
# Use test keys (sk_test_…) until launch. src/lib/stripe.ts refuses to start
# with a live key while SITE_LAUNCHED is not true, so set the flag first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Defaults for the Stripe Price IDs. The live pairing of display price to
# Price ID is the stripe_prices setting, edited in Admin, Plans and prices.
NEXT_PUBLIC_STRIPE_PRICE_LISTED=
NEXT_PUBLIC_STRIPE_PRICE_SPOTLIGHT=
NEXT_PUBLIC_STRIPE_PRICE_CLINIC=
# The founding cohort's price, locked at sign-up (src/lib/founding.ts).
NEXT_PUBLIC_STRIPE_PRICE_FOUNDING=

# ── Email (Resend) ────────────────────────────────────────────────────────
# With no key, every email is written to the server log instead of sent.
RESEND_API_KEY=

# Who the site's mail comes from. Must sit on the domain verified in Resend,
# or every send is rejected. Verifying the send. subdomain (which is what keeps
# Resend's records clear of the Hostinger mailbox) makes this
# "Equine Professionals Australia <notifications@send.equineprofessionals.com.au>",
# which is also the default in src/lib/resend.ts, so this only needs setting
# if the verified domain ever changes.
NOTIFICATIONS_FROM=

# Where a reply to one of the site's emails goes, and the inbox the site tells
# people to write to. Must be a mailbox somebody reads. Defaults to
# hello@equineprofessionals.com.au; REPLY_TO overrides it for email only, which
# is what to use if the public contact address and the reply address differ.
CONTACT_EMAIL=
REPLY_TO=

# ── The site's one base URL ───────────────────────────────────────────────
# Sitemap, canonical tags, structured data, email links and Stripe return
# URLs all build on this (src/lib/site-url.ts). On the test deployment it is
# the test host, so nothing there links to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cron ──────────────────────────────────────────────────────────────────
# Shared secret for every /api/cron/* job. Vercel Cron sends it once
# configured; only needed by hand for a manual call.
CRON_SECRET=

# Salt for the one-way visitor and IP hashes (profile view counts, the
# waitlist rate limit). Falls back to the service role key if unset.
COACH_EVENTS_SALT=

# ── Google Search Console (the weekly SEO digest) ─────────────────────────
# A service account's full JSON key on one line, plus the verified property,
# e.g. "sc-domain:equineprofessionals.com.au". The service account also has to
# be added as a user on the property in Search Console or every request 403s.
# The digest still runs and emails without these; the sections that need
# Search Console say they are not connected.
GOOGLE_SERVICE_ACCOUNT_KEY=
GSC_SITE_URL=

# Recipient for the weekly SEO digest email.
SEO_DIGEST_EMAIL=
